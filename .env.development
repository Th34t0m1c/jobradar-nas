# ============================================================
# JobRadar — DEVELOPMENT environment
# Copy this to .env for local development
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=JobRadar
DEBUG=true

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://jobradar:jobradar@postgres:5432/jobradar

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Dhaka
DAILY_JOB_HOUR=10
DAILY_JOB_MINUTE=0
JOB_FETCH_WINDOW_HOURS=25
JOB_RETENTION_DAYS=4

# ── Storage ──────────────────────────────────────────────────
CV_UPLOAD_DIR=/cv_data

# ── CORS ─────────────────────────────────────────────────────
# Dev: allow Vite dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend URL (used in password reset emails) ─────────
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP (password reset) ────────────────────────
# Use Mailtrap sandbox for local development:
#   https://mailtrap.io → Email Testing → SMTP Settings
# Leave SMTP_HOST empty to skip sending and print the link to FastAPI logs instead.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@jobradar.dev

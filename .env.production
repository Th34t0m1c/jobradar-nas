# ============================================================
# JobRadar — PRODUCTION environment
# Copy this to .env on your VPS
# NEVER commit this file to Git
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=JobRadar
DEBUG=false

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database (PostgreSQL) ────────────────────────────────────
# postgres service reads POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB from this file
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=jobradar
DATABASE_URL=postgresql://jobradar:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/jobradar

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Dhaka
DAILY_JOB_HOUR=10
DAILY_JOB_MINUTE=0
JOB_FETCH_WINDOW_HOURS=25
JOB_RETENTION_DAYS=4

# ── Storage ──────────────────────────────────────────────────
CV_UPLOAD_DIR=/cv_data

# ── CORS ─────────────────────────────────────────────────────
# Production: your actual domain only
CORS_ORIGINS=https://yourdomain.com

# ── Frontend URL (used in password reset emails) ─────────
FRONTEND_URL=https://nayeemhasan.xyz

# ── Email / SMTP (password reset) ────────────────────────
# Configure with your transactional email provider (Mailtrap production, SendGrid, Postmark, etc.)
# Port 587 uses STARTTLS. For port 465 (SSL), edit email_service.py: use_tls=True, start_tls=False
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@nayeemhasan.xyz
